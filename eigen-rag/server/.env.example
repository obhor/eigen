# Copy this to .env and fill in your values

# ── AI toggle ────────────────────────────────────────────────────────────────
# Set to true when you're ready to connect a real LLM.
# When false, /query returns a one-line mock answer (the prompt goes to the
# debug log only — never into the chat).
AI_ENABLED=false

# ── LLM provider ─────────────────────────────────────────────────────────────
# Supported: "openai" (OpenAI-compatible) | "gemini" (native)
LLM_PROVIDER=openai

# ── Gemini (native) ──────────────────────────────────────────────────────────
# Only used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI-compatible backend ────────────────────────────────────────────────
# Defaults to local ollama. Swap for OpenAI / LM Studio as needed.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2

# Set to your real key if using OpenAI instead of ollama
OPENAI_API_KEY=ollama

# Per-call limits: provider timeout (seconds) and answer length cap.
# A timeout returns 504; other provider failures return 502.
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=512

# ── Server ───────────────────────────────────────────────────────────────────
# Keep 127.0.0.1 unless you deliberately want the RAG API on the LAN.
HOST=127.0.0.1
PORT=8000

# Bearer token for /ingest and /query. Empty = no auth (localhost-only trust).
# If you set this, the app needs the same value: VITE_RAG_TOKEN, or
# localStorage.setItem('rag_token', '<value>') in the browser console.
RAG_TOKEN=

# Ingestion caps
RAG_MAX_UPLOAD_MB=50
RAG_MAX_PAGES=500

# How many document indexes stay in memory (LRU). Evicted doc_ids, and any
# doc_id after a server restart, return 404 — the client re-indexes on send.
RAG_MAX_STORES=8

# Scanned pages: Tesseract is budgeted per ingest (0 disables OCR entirely)
# and killed after RAG_OCR_TIMEOUT_S on any single page.
RAG_OCR_MAX_PAGES=50
RAG_OCR_TIMEOUT_S=30

# Comma-separated allowed browser origins ("null" = Electron file://)
RAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
